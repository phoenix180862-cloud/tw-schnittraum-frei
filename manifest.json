{
  "name": "TW Schnittraum",
  "short_name": "Schnittraum",
  "description": "Kostenloses Schnittprogramm im Browser: Handyvideos schneiden, vertonen, beschriften und als MP4 ausgeben – ohne Anmeldung, alles bleibt auf dem Gerät. Ein Geschenk von Thomas Willwacher Fliesenlegermeister e.K.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1923",
  "theme_color": "#0f1923",
  "icons": [
    {
      "src": "img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "files": [
        {
          "name": "medien",
          "accept": [
            "video/*",
            "image/*",
            "audio/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/*": [
          ".mp4",
          ".mov",
          ".m4v",
          ".webm",
          ".mkv"
        ],
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp"
        ],
        "audio/*": [
          ".mp3",
          ".m4a",
          ".wav"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}